// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// CHECK constraints Prisma does not model - they live only in the migrations,
// so `migrate diff` cannot see them. Every one, by name:
//   Bottle_lot_sane, Bottle_quantity_positive, Bottle_status_known (NOT VALID)
//   Domaine_limits_sane, UsageEvent_nonnegative
//   PairingPick_decision_known, PairingPick_drank_was_planned,
//   PairingPick_took_bottle_was_drunk
//   User_digestFrequency_known
// Each is explained on the field it guards.

// The person a cellar belongs to.
//
// Phases 0 through 3 of separate cellars (FUTURE_CAPABILITIES.md) are
// done: a cellar belongs to a Domaine (see below), lib/scoped-prisma.js
// scopes essentially every read and write by it, and an Auth.js session
// (or, until accounts are configured, the single seeded row) decides who
// is asking on each request. Bottle.ownerId and its siblings survive only
// as "added by" attribution. Phase 4 (per-section access) is not started.
//
// Deliberately shaped as Auth.js's `User` from the outset rather than as a
// throwaway `Owner`, because Phase 1 adopts @auth/prisma-adapter and that
// adapter owns this table. Getting the shape right now means Phase 1 adds
// Account/Session/VerificationToken beside it and wires the adapter - it
// never has to move ownership from one table to another on live data, which
// is the one migration in this plan worth being frightened of.
//
// The shape is taken from the adapter's own source, not from memory:
// `createUser` destructures the id away and lets the database generate one
// (`p.user.create` with the rest), so `id` must have a default; and
// `getUserByEmail` looks up `where: { email }`, so email must be unique.
// Nullable because not every provider returns one.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Phase 0 of "Shared cellars" (FUTURE_CAPABILITIES.md): the estate a
  // person belongs to, and what they can do there. One Domaine per User,
  // decided rather than a many-to-many membership - simplest shape for
  // the actual ask (a family/friends cellar with a couple of full-access
  // people and some guest-like ones), and it means there is no "which
  // Domaine is active" concept to build anywhere, ever. NOT NULL: every
  // existing User was backfilled its own new Domaine in the migration
  // that added this column, one each - never merged together, since two
  // people's previously-separate cellars silently becoming one shared
  // cellar would be exactly the kind of leak this schema's scoping exists
  // to prevent.
  //
  // Since Phase 1 of Shared cellars this is what every cellar query is
  // scoped by (lib/scoped-prisma.js): every member of a Domaine sees and,
  // as a Cellarmaster, edits the same bottles, flights and pairings. Set
  // once, at account creation, from the invite that let this person in
  // (see Invite.access and createUser in lib/auth.js) - or a brand new
  // Domaine of their own when the invite said so.
  domaineId String
  domaine   Domaine @relation(fields: [domaineId], references: [id], onDelete: Cascade)
  // "cellarmaster" (full access - add, edit, scan, delete, run Suggest and
  // Research) or "guest" (browse and favorite, no editing). The guest role
  // replaced the old anonymous /guest link, retired 2026-09-28 (BACKLOG
  // #51): a guest is now always a signed-in member the Domaine chose. Every
  // User backfilled by the Phase 0 migration is "cellarmaster", since they
  // were each already the sole full-access person in their own cellar. A
  // "guest" member is refused by lib/scoped-prisma.js outright (reads
  // included - they browse through /guest's plain-client view instead)
  // and redirected there by app/(owner)/layout.js.
  role      String

  // What this person added. Since the ownership roots moved to domaineId
  // (Phase 1 of Shared cellars) these are attribution, not ownership: a
  // bottle belongs to the Domaine, and ownerId only records which member
  // put it there - SetNull on the roots, so removing one member of a
  // shared Domaine never takes everyone's cellar with them. ResearchJob
  // still cascades: it's a transient job row, not a list of anyone's
  // things.
  bottles      Bottle[]
  flights      TastingFlight[]
  pairings     SavedPairing[]
  researchJobs ResearchJob[]

  // Auth.js's side of this table. Both cascade: deleting a person takes
  // their sign-in records with them.
  accounts Account[]
  sessions Session[]

  // The favorites identity of a guest-role member (see Guest.userId).
  guest Guest?

  // True for the one account that runs the app: pays for the API key, and
  // alone sees every Domaine's AI spend and sets its limits (/usage). A
  // person, not a Domaine - the earlier rule ("any Cellarmaster of the
  // original Domaine") made everyone who was ever added to that Domaine an
  // operator. Set by migration (20260930000000) on the earliest-created
  // account, and by hand from there, never by the app: nothing here can
  // grant or take it, and removeMember / changeMemberRole refuse to touch
  // the account that has it, so the app can never end up without one.
  // OWNER_EMAIL only decides who may *claim* the seeded cellar at first
  // sign-in (lib/auth.js); it plays no part in this.
  isAppOwner Boolean @default(false)

  // Claude calls this person made - attribution only, like Bottle.ownerId.
  // The cap is summed over the Domaine, not the person.
  usageEvents UsageEvent[]

  // The cellar digest email (app/api/digest/route.js): "weekly", "monthly" or
  // NULL for off. NULL is the default and nobody is opted in by anything but
  // their own choice on the People page. A person's own setting, not the
  // Domaine's: each member decides what lands in their inbox.
  // CHECKed to 'weekly' | 'monthly' (User_digestFrequency_known), so adding a
  // word needs a migration - unlike the plain-String columns elsewhere. The
  // People page only offers monthly: windows are whole years, so a weekly
  // email would repeat itself.
  digestFrequency  String?
  // When the last digest was claimed for this person. The cron route claims a
  // send with a conditional UPDATE on this column (set only if it still holds
  // the value that was read), so two overlapping runs cannot both send; a
  // failed send puts the old value back. NULL = never sent.
  digestLastSentAt DateTime?

  // Created by 20260928040000_domaine_and_membership, which is why it's
  // declared here: without it, the next generated migration would drop it.
  @@index([domaineId])
}

// The estate itself - "more expansive than just the cellar," per the
// nomenclature decision in FUTURE_CAPABILITIES.md: the account-level
// container a User belongs to, and (since Phase 1 of Shared cellars) what
// owns the cellar itself. Bottle, TastingFlight and SavedPairing each
// carry a domaineId, and lib/scoped-prisma.js scopes every query by it,
// so every member of one Domaine shares one cellar. Deleting a Domaine
// takes all of it with it - which is why nothing in the app does.
model Domaine {
  id        String   @id @default(cuid())
  // Both were on User until this migration - see that model's own
  // members/role comment for why they moved. Nullable for the same
  // reason they always were: not every Cellarmaster bothers naming their
  // estate, and a blank one falls back to the person's own name wherever
  // this is shown (see cellarDisplayName in lib/cellar-name.js).
  name      String?
  motto     String?
  // When the Domaine was made - for one backfilled by a migration, the
  // migration's own timestamp, not when the person actually arrived.
  createdAt DateTime @default(now())

  // What this Domaine may spend on Claude each calendar month (UTC) - see
  // UsageEvent below and lib/usage.js. Both in cents, both nullable, and
  // null means "no limit of this kind" (the app owner's own Domaine, by
  // design - the owner pays for the app, so a cap on them would be a cap
  // on themselves; see FUTURE_CAPABILITIES.md, Phase 3). That is not the
  // same as 0: 0 means the limit is hit immediately, so every Suggest and
  // Research call is already on the lighter model (cap) or refused (hard
  // stop). A CHECK constraint keeps both non-negative and the hard stop at
  // or above the cap.
  //
  // Past the cap, Suggest and Research keep working on a lighter model (one
  // tier down); Scan and the drinking-window estimators stay at full
  // strength (holdTier in lib/usage.js). Past the hard stop everything
  // pauses until the 1st. The hard stop is the runaway guard - a loop, a
  // leaked session - and should sit far enough above the cap that ordinary
  // use never reaches it. Only the app owner sets either, on /usage: a
  // Domaine's own Cellarmasters would be raising their own limit on
  // someone else's API key.
  monthlySpendCapCents Int?
  monthlyHardStopCents Int?

  members      User[]
  invites      Invite[]
  bottles      Bottle[]
  flights      TastingFlight[]
  pairings     SavedPairing[]
  researchJobs ResearchJob[]
  usageEvents  UsageEvent[]
  bottleTrash  BottleTrash[]
  importBatches ImportBatch[]
}

// Auth.js's own three tables, plus the invite list.
//
// Every field name and every unique constraint below is taken from
// @auth/prisma-adapter's source rather than from memory, because the
// adapter queries them by name and a near-miss fails at sign-in rather
// than at build: it looks up `account.findUnique({ where: {
// provider_providerAccountId } })`, `session.findUnique({ where: {
// sessionToken } })` and `verificationToken` by `identifier_token`, so
// those compound keys have to exist with exactly those shapes.
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // snake_case above is not an oversight - those are OAuth's own wire
  // names, and the adapter writes the provider's response through
  // unchanged. Renaming them to match the rest of this schema would mean
  // mapping every one by hand for no gain.
  @@id([provider, providerAccountId])
  @@index([userId])
}

// Database sessions rather than JWTs, which is what an adapter gives you
// by default and the right default here: signing someone out, or removing
// their invite, takes effect on their next request instead of whenever
// their token happens to expire. The cost is a query per request, on an
// indexed unique column, which is nothing next to the page's own reads.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Backs the email/"magic link" sign-in door (lib/auth.js), the second
// route in alongside Google - one row per link sent, deleted the moment
// it is used or once it expires. Created in the original Phase 1
// migration before that second door existed, on the grounds that the
// adapter is a single object that implements every method and one that
// references a missing table fails at the moment someone tries the flow
// rather than at setup; no new migration was needed to put it to use.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Who is allowed in at all. Invite-only was the decision (see
// FUTURE_CAPABILITIES.md): no open registration, no email verification to
// own, and the shared API key stays spent by people who were asked.
//
// A table rather than an environment variable so the list can change
// without a redeploy - which is what makes it worth an admin screen, and
// what makes it scale past the handful an env var comfortably holds.
//
// Email is the join key because it is the only thing known about a person
// before they have ever signed in. Stored lowercased by every writer, so
// the unique constraint means what it looks like it means.
model Invite {
  id    String  @id @default(cuid())
  email String  @unique
  // Whose email this is, in the owner's own words. An invite list of bare
  // addresses becomes unreadable within about four entries.
  note  String?

  // The Domaine this invite was sent from - whose /invites list it shows
  // on, and who can revoke it. Email stays globally unique: one address,
  // one way in, whichever Domaine asked first.
  domaineId String
  domaine   Domaine @relation(fields: [domaineId], references: [id], onDelete: Cascade)
  // What signing in with this address gives them, decided once at account
  // creation (createUser in lib/auth.js) and never re-read afterwards:
  //   "cellarmaster" - joins domaineId's Domaine with full access
  //   "guest"        - joins domaineId's Domaine, browse and favorite only
  //   "separate"     - a new, empty Domaine of their own (what every
  //                    invite meant before Domaines could be shared, and
  //                    what every pre-existing invite was backfilled to,
  //                    apart from each Domaine's own founder)
  access    String

  createdAt  DateTime  @default(now())
  // Stamped on the invited person's first successful sign-in, so the list
  // shows who has actually turned up rather than only who was asked.
  acceptedAt DateTime?

  @@index([domaineId])
}

// A single wine - or, once it has a size, place and price, one LOT of it (see
// the lot comment below) - in one of four states:
// - wishlist: something to try or buy, not owned yet
// - inventory: currently owned/in the cellar
// - flight: queued for a flight and never (yet) owned - a wine tasted at
//   an event, poured from someone else's bottle, never bought as your
//   own. Distinct from inventory precisely so it never counts as
//   Cellar/owned stock; distinct from consumed because it hasn't been
//   tasted yet. Its only home in the app is the flight it belongs to
//   (see FlightPick) - graduates to consumed the same way an inventory
//   bottle does, by marking its flight pick tasted.
// - consumed: already drunk, kept around so its tasting notes stay attached
model Bottle {
  id                   Int       @id @default(autoincrement())
  producer             String
  // The specific bottling, when a producer makes more than one wine from
  // the same grape/vintage - a vineyard designation (e.g. "Rochioli
  // Vineyard") or a proprietary/cuvée name (e.g. "Madeleine", "Insignia").
  // Real labels blur these two concepts constantly (a vineyard-designated
  // wine often carries a proprietary-sounding name too), so this is
  // deliberately one flexible field rather than two, the same reasoning as
  // `region` below.
  bottling             String?
  vintage              Int?
  // Short, header-friendly style label - usually just the grape variety
  // (e.g. "Zinfandel"), but a concise descriptor for blends or wines with
  // no single named variety (e.g. "Red Bordeaux Blend", "Orange Wine").
  // `variety` below can hold a fuller, more detailed description.
  type                 String?
  variety              String?
  // A grape name from lib/varietals.js's canonical list, auto-matched from
  // `type`/`variety` on save (see lib/varietal-match.js) whenever they
  // name exactly one recognized grape - null for a blend or an
  // unrecognized/obscure variety, rather than guess. Lets filtering match
  // synonyms (e.g. "Grenache" also finds a bottle logged as "Garnacha")
  // without changing what's actually printed on the label in `variety`.
  canonicalVariety     String?
  // The primary sub-country identifier - a US state for domestic wines
  // (e.g. "California"), or a named wine region/appellation for everything
  // else (e.g. "Bordeaux", "Burgundy", "Central Otago"). Deliberately just
  // one flexible field rather than a rigid state/region/subregion
  // hierarchy, since that hierarchy genuinely differs by country and even
  // by wine - a fuller drill-down (like Bordeaux -> Medoc -> ...) can be
  // layered on top of this later without a schema rework.
  region               String?
  // An optional finer-grained locator within `region` (e.g. "Margaux"
  // within region "Bordeaux", or "Gevrey-Chambertin" within "Burgundy") -
  // BACKLOG.md #2's lightweight step: one more flat, optional field rather
  // than a rigid multi-level hierarchy tree, so a country/region/
  // sub-region/appellation drill-down can still be layered on properly
  // later without this being in the way.
  subRegion            String?
  country              String?
  // Bottles in this lot, always >= 1 (CHECK Bottle_quantity_positive, not
  // modelled by Prisma): tasting the last bottle moves the row to History at
  // quantity 1, while "Tasted all" keeps the count, so on a History row this is
  // "how many were in the lot when it was finished", not a number to sum for
  // value. Totals of money or litres count cellar rows only.
  quantity             Int       @default(1)
  // "inventory" (Cellar), "wishlist", "consumed" (Tasting notes) or "flight":
  // lib/bottle-status.js. Held by the CHECK Bottle_status_known, added NOT VALID
  // so a deploy never fails on old rows; run VALIDATE CONSTRAINT to prove them.
  status               String    @default("wishlist")
  // The owner's own words about the bottle, as opposed to criticNotes
  // (someone else's words, written by Research) or a TastingNote (about one
  // evening). Where the bottle came from lives here - a shop, the winery, a
  // gift - which is the only fact about a bottle with no field of its own.
  // Called "Source" in the app. Deliberately free text rather than an acquisitionSource column: the
  // answers are long-tailed and never filtered on.
  notes                String?
  // Alcohol by volume, as printed on the label (e.g. 14.5 for "14.5%").
  // Legally required on nearly every label, so easy to capture during
  // scanning, and useful for style/pairing reasoning (a 15.5% Zinfandel
  // behaves very differently at the table than a 12.5% Riesling).
  abv                  Float?
  // A small fixed vocabulary (Red/White/Rosé/Orange/Sparkling/Dessert/
  // Fortified - see WINE_COLORS in lib/wine-colors.js), distinct from `type`
  // (which names the grape/style, not the color) so "show me all my
  // whites" works regardless of how `type` happens to be worded. A plain
  // String rather than a Prisma enum, same reasoning as `status` below -
  // easier to extend the vocabulary later without a migration. Not
  // auto-guessed from type/variety on manual entry (the same grape can
  // make wines of different colors - a Pinot Noir rosé, for instance - so
  // a text-based guess could confidently mislabel one); the scan feature
  // does infer it, since it can actually see the label/context.
  wineColor            String?
  // The drinking window: the year range this wine is expected to be at its
  // best (e.g. drinkFrom 2026, drinkTo 2034). Both nullable and independent
  // - a wine can have a known start with no known end, or vice versa. Feeds
  // the Suggest feature's reasoning (don't recommend something not ready
  // yet, or already past peak) - see BACKLOG.md #4.
  drinkFrom            Int?
  drinkTo              Int?
  // True when drinkFrom/drinkTo came from an AI guess (scan, Research's
  // fallback, a bulk backfill, or a dedicated estimate action - see
  // BACKLOG.md #7) rather than something stated on the label, found via a
  // real Research citation, or typed by hand. Shown as a distinct badge so
  // it's clear which windows are worth double-checking. Only ever set by
  // those estimate-producing actions (or an imported window, below); a plain edit through updateBottle
  // clears it back to false when the years actually change (the human has
  // now made the call), and leaves it alone otherwise. A CSV import also sets
  // it true for any window in the file: a spreadsheet cell is not a sourced
  // window.
  drinkWindowEstimated Boolean   @default(false)
  // Set when the scan feature wasn't confident about every field it filled
  // in (see `confident` on the scan tool). Surfaces the bottle in the
  // "Needs research" queue until someone runs (or dismisses) the "Research
  // further" action on its page - never cleared automatically otherwise.
  needsResearch        Boolean   @default(false)
  // The scanned label photo, uploaded to Vercel Blob storage (see
  // lib/blob.js) at scan time - null for a manually-added bottle, or when
  // blob storage isn't configured (the scan feature still works without
  // it, same graceful-degradation spirit as ANTHROPIC_API_KEY being
  // optional). One photo can hold several wines (a shop's tasting sheet),
  // in which case each of those bottles shares the same photoUrl.
  photoUrl             String?
  // When the last bottle of this wine actually left the cellar. Nullable
  // and only meaningful for a `consumed` row: set on whichever action moved
  // it there, cleared if it ever moves back out, so a bottle returned to
  // Inventory doesn't keep claiming a date it was emptied on. Rows that
  // reached History before this column existed have null, which reads as
  // "emptied, date unknown" rather than as a wrong date - see BACKLOG.md
  // #10. Stored like TastingNote.tastedAt, anchored at noon UTC: see
  // lib/tasting-date.js for why a date-only value needs that.
  emptiedAt            DateTime?
  // When this wine entered the cellar, as opposed to createdAt's "when the
  // row was typed in" - the two are only the same for a bottle you log the
  // day you buy it. Nullable, and deliberately left null rather than
  // guessed: a wishlist bottle isn't owned yet, and a wine logged straight
  // to tasting notes never sat in the cellar at all, so neither has an
  // acquisition date to record. Derived from status changes the way
  // emptiedAt is (see acquiredAtForStatus in lib/bottle-dates.js) - stamped when
  // a row arrives in the cellar, cleared if it goes back to the wishlist,
  // and carried through to consumed, where "bought 2019, drunk 2026" is
  // exactly the fact worth keeping. Rows that predate this column have
  // null, which reads as "date unknown" rather than as a wrong date - see
  // BACKLOG.md #10. Anchored at noon UTC like every other date-only value:
  // see lib/tasting-date.js.
  acquiredAt           DateTime?
  // Existing winemaking/tasting notes found *about* this wine by the
  // Research feature - the winery's own description, critic write-ups
  // (Wine Advocate, Wine Spectator, Halliday, Jancis Robinson, etc.), or
  // other published reviews - as opposed to `notes` (this cellar owner's
  // own free-form notes) and `TastingNote` (their own dated tasting
  // entries). Only ever populated by applying a research result; never set
  // by scanning or by a plain manual edit, though it's an ordinary
  // editable field once research has filled it in.
  criticNotes          String?
  // A bottle row is a LOT: a stack of identical bottles of one wine that share
  // a size, a place and a unit price. Two purchases of the same wine at
  // different prices, or bottles split across two places, are two rows - never
  // one row holding several - so the columns below stay single values. Each is
  // nullable and null means "not recorded", never a default.
  //
  // `sizeMl`: the bottle size in millilitres (750 standard, 375 half, 1500
  // magnum). Millilitres rather than an enum or a name so an odd size (500,
  // 620) still sorts and sums. Null is NOT 750: it is "not recorded"; only one
  // helper (lib/bottle-sizes.js) treats null as standard, and only for litre
  // totals. `quantity` stays the number of bottles of THIS row's size.
  sizeMl               Int?
  // `location`: where it physically is ("Rack B", "Fridge", "Storage unit").
  // Free text, trimmed and collapsed, adopting an existing spelling on a
  // case-insensitive match (so "rack b" files under "Rack B"); renaming or
  // merging a place is one UPDATE of this column. Domaine-wide, as the bottle
  // is. Not a table: there is nothing to say about a place yet beyond its name.
  location             String?
  // `pricePaidCents` + `priceCurrency`: what ONE bottle of this row's size
  // cost, in minor units (integer cents, the `*Cents` convention used for
  // spend caps) with its ISO currency. Null = not recorded; 0 = a gift. Both
  // set or both null (a CHECK). Per bottle because that is the only value that
  // stays true as bottles are drunk: a row's value is quantity x unit. The
  // `acquiredAt` date is when it arrived and `createdAt` is when the row was
  // typed; the price belongs to the purchase, so a different price is a
  // different row. Moving a wine back to the wishlist does not clear it, but
  // totals of money count cellar rows only (a History row's quantity is not a
  // reliable count of what was bought - see `quantity`). Where it was bought stays in
  // `notes` ("Source"), which is deliberately free text.
  pricePaidCents       Int?
  priceCurrency        String?
  // CHECK constraints Prisma does not model (see the migration): Bottle_lot_sane
  // (size 50-30000 ml, a non-blank place, price >= 0 with currency set
  // together and three capital letters) and Bottle_quantity_positive. Both are
  // invisible to `migrate diff`.

  // Whose cellar this is - every member of the Domaine sees it, and
  // lib/scoped-prisma.js filters every query on it.
  domaineId String
  domaine   Domaine @relation(fields: [domaineId], references: [id], onDelete: Cascade)
  // Which member added it - attribution, not ownership (see the User
  // model's own comment). Null once that member's account is gone.
  ownerId   String?
  owner     User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tastingNotes     TastingNote[]
  favorites        Favorite[]
  flightPicks      FlightPick[]
  pairingPicks     PairingPick[]
  photos           BottlePhoto[]
  researchProposal ResearchProposal?

  // Every list page filters on `status`, and the nav badge counts
  // `needsResearch`, on every request. A few hundred rows sequential-scan
  // fine, so this isn't fixing a problem you can feel today - it's just
  // cheap to have in place before the cellar is big enough to notice.
  @@index([status])
  @@index([needsResearch])
  // Postgres does not index a foreign key automatically, and domaineId is
  // the column every scoped query filters on.
  @@index([domaineId])
  @@index([ownerId])
}

// One additional photo attached to an already-saved bottle - `photoUrl`
// above is the single label photo captured at scan time; this is for
// anything worth documenting afterward (a back label, a cork, a case),
// added via "Add a photo" on the bottle's detail page - akin to how the
// Research feature adds detail after the fact rather than only at save
// time. Not read by any AI feature, just stored and shown back.
model BottlePhoto {
  id        Int      @id @default(autoincrement())
  bottleId  Int
  bottle    Bottle   @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())

  // Postgres does not index a foreign key automatically, and this column is
  // what every lookup and cascade delete goes through. Same below.
  @@index([bottleId])
}

model TastingNote {
  id       Int      @id @default(autoincrement())
  bottleId Int
  bottle   Bottle   @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  note     String
  // Nullable: a note can be logged without a personal score - e.g. a shop's
  // own tasting-sheet write-up brought in via the scan feature, before (or
  // instead of) rating it yourself.
  rating   Int?
  tastedAt DateTime @default(now())

  @@index([bottleId])
}

// The favorites identity of a signed-in "guest" member (User.role): found
// by userId, created on their first visit to /guest and named after their
// account (see resolveGuestView in lib/guest.js). The Domaine's
// Cellarmasters see this name next to each favorite.
//
// A row with a null userId is a leftover from the anonymous /guest link
// (a name remembered via a cookie), retired 2026-09-28 - BACKLOG #51.
// Those rows and their favorites were left in place so the names already
// shown next to a favorite still make sense; nothing creates new ones.
model Guest {
  id        Int        @id @default(autoincrement())
  name      String
  createdAt DateTime   @default(now())
  favorites Favorite[]
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One guest's shortlist pick from the (inventory-only) cellar they browsed
// at /guest - surfaced back to the owner so they know what to pull before
// that guest's next visit.
model Favorite {
  id        Int      @id @default(autoincrement())
  guestId   Int
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  bottleId  Int
  bottle    Bottle   @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // The unique already indexes guestId as its leading column, so only the
  // other direction (which guests favorited this bottle) needs one.
  @@unique([guestId, bottleId])
  @@index([bottleId])
}

// A saved Suggest tasting-flight result (mode: "tasting") - unlike a
// pairing recommendation, which is ephemeral and logs straight into a
// tasting note, a themed flight is worth keeping around as a queue to pull
// bottles from over time. Only real owned-bottle picks are saved; a gap
// suggestion mixed into the same result isn't part of "what to pull from
// the cellar" and can already be added to the wishlist independently.
model TastingFlight {
  id      Int     @id @default(autoincrement())
  // A short evocative name for the flight ("The Many Faces of Pinot") -
  // the heading, and what the flights list links on. Nullable because
  // flights saved before this existed have only a summary, which they
  // keep showing as their heading rather than getting a guessed title.
  title   String?
  // The fuller explanation of the theme and its ordering. Before `title`
  // it was doing both jobs, which made for a three-sentence link.
  // Nullable since flights can be built by hand: a flight you assembled
  // yourself has a theme name and often nothing else to say. At least one
  // of title/summary is always set - guaranteed where flights are written,
  // not by the columns, since neither can be NOT NULL on its own.
  summary String?

  // Same pair as Bottle's: the Domaine owns it, ownerId only says who
  // made it.
  domaineId String
  domaine   Domaine @relation(fields: [domaineId], references: [id], onDelete: Cascade)
  ownerId   String?
  owner     User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime     @default(now())
  picks     FlightPick[]

  @@index([domaineId])
  @@index([ownerId])
}

// One bottle's place in a saved flight, in tasting order.
model FlightPick {
  id               Int           @id @default(autoincrement())
  flightId         Int
  flight           TastingFlight @relation(fields: [flightId], references: [id], onDelete: Cascade)
  bottleId         Int
  bottle           Bottle        @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  order            Int
  // Why this bottle is in this flight, in the model's words. Null for a
  // pick added by hand, which has a position in the running order but no
  // argument attached to it.
  reason           String?
  consumed         Boolean       @default(false)
  // True when the bottle behind this pick was status "flight" (never
  // Cellar inventory) at the moment it joined - as opposed to "inventory"
  // (a bottle you already owned, added the ordinary way). Both eventually
  // read `bottle.status === "consumed"` once tasted, so this is what
  // markFlightPickConsumed/unmarkFlightPickConsumed (see app/actions.js)
  // use to know which status to move the bottle to and back from: a
  // flight-only bottle graduates straight to consumed and, on Undo,
  // straight back to flight - never to inventory, since it was never
  // that. Set once at creation (see addBottleToFlight,
  // addBottlesToFlight, saveTastingFlight) and never changed afterward.
  originFlightOnly Boolean       @default(false)

  @@index([flightId])
  @@index([bottleId])
}

// A drinking-window estimate Claude has already produced for a given wine,
// keyed on which wine it is (producer, bottling, vintage - the app's one
// definition of "the same wine", lib/wine-key.js; see drinkWindowCacheKey)
// rather than on a bottle id. Two rows for the same wine, or the same wine
// re-added months later, then reuse the earlier answer instead of paying
// for an identical question - see BACKLOG.md #7.
//
// Deliberately not a hand-curated reference table: that would need the same
// domain judgment we're already asking the model for, just harder to keep
// current. This only avoids asking twice.
model DrinkWindowEstimate {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  drinkFrom Int?
  drinkTo   Int?
  createdAt DateTime @default(now())
}

// A research pass waiting to be reviewed.
//
// Research used to live in React state on the bottle page and die the
// moment you navigated away, which left "researched but not yet approved"
// with nowhere to exist - so the queue needed somewhere to put it.
//
// One row per bottle: researching a second time replaces the pending
// answer rather than stacking up proposals nobody asked for.
model ResearchProposal {
  id       Int    @id @default(autoincrement())
  bottleId Int    @unique
  bottle   Bottle @relation(fields: [bottleId], references: [id], onDelete: Cascade)

  // The model's answer, shaped exactly like RESEARCH_TOOL's input schema -
  // see the comment beside it in app/actions.js. Json rather than a dozen
  // mirrored Bottle columns: the proposal is only ever read back whole and
  // rendered, and this way the research schema can change without a
  // migration. lib/research-fields.js is what reads it.
  proposed Json

  // What the model says it found, and where. Kept beside the proposal
  // because both are part of judging it, not part of the bottle.
  summary String
  sources String[]

  // Compared against the bottle's updatedAt to spot a proposal computed
  // from values that have since changed. Flagged in the review rather than
  // discarded - see isProposalStale().
  createdAt DateTime @default(now())
}

// One run of "Research all", as a row rather than as a closure.
//
// The bulk pass has been rewritten twice for the same reason, and this
// table is the third and last version of the answer. Originally the
// chunking lived in the browser, so navigating away stopped the run dead.
// Moving the chunking server-side and chaining with `after()` fixed that
// but bounded the whole queue to one invocation's timeout, which is a
// ceiling the browser loop never had - a long enough queue just stopped
// partway, looking exactly like the bug it replaced.
//
// Both versions had the same root flaw: the queue only existed in memory,
// so its life was tied to something that dies. Here it is a row. Each step
// reads what is left, does what it can afford inside its own timeout,
// writes back, and asks for a fresh invocation to continue - so the total
// run has no ceiling, and the progress the page shows is the real server
// state rather than a counter in a tab that may not be open.
model ResearchJob {
  id    Int    @id @default(autoincrement())
  // What each step has to present to be allowed to run, since the step
  // endpoint is a plain HTTP route rather than a signed-in page - see
  // ownerId below for why that matters here specifically. A per-job random
  // value rather than a shared deployment secret: it needs no configuration
  // to be correct, it is useless once its own job is finished, and it never
  // reaches the browser - only the server ever reads or sends it.
  token String @unique

  // Who asked - attribution. What the job may touch is domaineId, below.
  // Every other Domaine-scoped model (Bottle, TastingFlight, SavedPairing)
  // gets its scoping enforced by the Prisma Client Extension in
  // lib/scoped-prisma.js, which reads the signed-in session - but a bulk
  // research step runs from app/api/research/step/route.js, a plain HTTP
  // route hit by a server-to-server fetch with no cookies attached (see the
  // route's own comment). There is no session to read there, so the
  // Domaine has to be recorded as data at job creation time instead, and
  // the step that fetches bottles to research filters on it explicitly
  // rather than going through the session-based extension. Without it, a
  // job's bottleIds would be trusted at face value with nothing checking
  // they belong to whoever started the run.
  ownerId   String
  owner     User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Whose cellar the job may touch - what researchStep actually filters
  // bottles by, since bottles belong to a Domaine rather than to whoever
  // happened to press "Research all". ownerId above still says who did.
  domaineId String
  domaine   Domaine @relation(fields: [domaineId], references: [id], onDelete: Cascade)

  // The queue as it was requested: the denominator of the progress bar,
  // and the record of what this run was asked to do.
  bottleIds  Int[]
  // What is still owed. Rewritten after each step rather than advanced by
  // an index, because a step finishes whole *questions* (duplicate wines
  // are researched once and the answer shared), which do not line up with
  // contiguous slices of the list.
  pendingIds Int[]

  researched Int @default(0)
  failed     Int @default(0)

  // "running" until pendingIds empties, then "done" - or "paused" when the
  // Domaine reached its hard stop mid-run (pendingIds is kept, so nothing is
  // lost, but nothing resumes by itself: start "Research all" again once the
  // limit lifts). No "failed" state: a bottle whose research fails is counted
  // in `failed` and the run carries on, which is the behaviour the queue has
  // always had.
  status String @default("running")

  createdAt DateTime @default(now())
  // Touched by every step, which is what lets a reader tell a run that is
  // working from one whose chain broke mid-flight (a deploy, a crash)
  // without a heartbeat column of its own.
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerId])
  @@index([domaineId])
}

// A pairing worth keeping. Its own table rather than a row in
// TastingFlight, for three reasons that all point the same way.
//
// Origin: a flight has two - Suggest and NewFlightForm - and FlightPick's
// `reason` is nullable for the hand-added ones. A pairing only ever comes
// from Suggest. Lifecycle: isOpenFlight() says a flight is a queue while
// any pick is undrunk and "a record now, not a queue" once they are all
// done - a pairing has nothing that elaborate, just `plannedFor`
// below, an owner-set day rather than anything the app derives. Owned vs
// not: FlightPick.bottleId is correctly NOT NULL because you
// cannot open a wine you do not have, and "buy this for that dish" is the
// entire point of Suggest's include-outside toggle.
//
// Sharing one table would leave `order` and `consumed` meaningless for
// half the rows, which is "null means not applicable" living in the same
// column as "null means unknown" - the distinction the rest of this
// schema works to keep.
model SavedPairing {
  id                  Int       @id @default(autoincrement())
  // The model's own title, which the owner can rename. NOT NULL unlike
  // TastingFlight.title: every pairing is born from a Suggest result,
  // where the title is a required tool field, so there is no such thing
  // as a pairing without one and no reader that has to cope with the
  // absence.
  title               String
  // What was asked for, word for word, plus the three settings that were
  // in force. These are what make refining cheap - reload the form from a
  // saved pairing, change one control, run it again - and without them
  // iterating would be a feature rather than four columns.
  request             String
  character           String
  // Which model answered: "standard" (Sonnet) or "sommelier" (Opus). Was
  // `effort` and held a thinking-budget level, back when Suggest always
  // ran on Opus and the dial only changed how long it thought. Renamed
  // rather than reused because the column records what was in force, and
  // what is in force is now a different fact about the request - leaving
  // the old name would have meant a column called effort holding a model.
  // See lib/suggest-depth.js for what the two levels cost and buy.
  depth               String
  includeOutside      Boolean
  // The model's "why these". Nullable because it is the argument, not the
  // identity: a pairing with its picks and their reasons is still whole
  // without it.
  summary             String?
  // The day this pairing is planned for, as a calendar day anchored at noon
  // UTC (lib/tasting-date.js: a date the owner picks, not an instant). NULL
  // means not planned. Replaces the old "drink tonight" flag, which could
  // only say "now" and then went stale; the day is what lets a pairing be
  // for tomorrow or Saturday, and lets "Tonight" be worked out against the
  // reader's own date. Marks the whole pairing, not one wine within it - a
  // multi-course menu is one evening - and any number of pairings can be
  // planned for the same day (an aperitif pairing and a dinner pairing).
  // Owner-set and owner-cleared only ("Done"): nothing in this app ever
  // clears it, on purpose - an auto-clear risks leaving it silently stuck
  // on if one wine's note never gets written, which is worse than asking
  // for one more tap. A day that has passed is shown as "Queued", not
  // dropped: it is still waiting to be done.
  plannedFor          DateTime?

  // Same pair as Bottle's: the Domaine owns it, ownerId only says who
  // kept it.
  domaineId String
  domaine   Domaine @relation(fields: [domaineId], references: [id], onDelete: Cascade)
  ownerId   String?
  owner     User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime      @default(now())
  picks     PairingPick[]

  @@index([domaineId])
  @@index([ownerId])
}

model PairingPick {
  id        Int          @id @default(autoincrement())
  pairingId Int
  pairing   SavedPairing @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  // The order the wines were suggested in. Not a tasting order the way
  // FlightPick.order is - a menu's courses have a sequence, a single dish
  // with one wine does not - but the order is still what was said, and
  // re-sorting it on read would be inventing something.
  order     Int
  // Which dish or course this wine is for. Null when the request named one
  // dish, or none: a pairing can be a dish with one wine or a menu with
  // several, and this column is what tells them apart.
  dish      String?
  reason    String

  // The wine this pick is linked to: one the owner had when the pairing was
  // kept, or - for a gap pick - one linked later by choosing Drink (see the
  // table under `gap`). SetNull rather than Cascade - the opposite of
  // FlightPick - because the two rows mean different things. A bottle you no
  // longer have cannot be in a queue of bottles to open, but it can
  // certainly be in the record of what you drank with the lamb in June, and
  // losing that record to an October tidy-up would be the wrong answer.
  bottleId  Int?
  bottle    Bottle? @relation(fields: [bottleId], references: [id], onDelete: SetNull)
  // How the wine read at the moment it was saved. The reason the row
  // above can go null without the pairing becoming unreadable, and the
  // reason a bottle renamed since still shows the name it was chosen
  // under.
  wineLabel String
  // The producer alone - the same snapshot as wineLabel, trimmed to what a
  // list summary can afford to show beside two or three dish names without
  // crowding them out. Stored rather than parsed back out of wineLabel at
  // read time, for the same reason wineLabel itself is a stored snapshot
  // rather than a live read off the bottle: re-deriving "just the
  // producer" from a formatted string (which quoted bottling name, which
  // 4-digit number is a vintage and not part of the name) is exactly the
  // fragile parsing this schema avoids elsewhere.
  wineName  String
  // A wine that was not owned when the pairing was kept, as {producer, type,
  // region, country}. Json for the same reason ResearchProposal.proposed is:
  // it is only ever rendered as a unit, never queried into. Keeping a
  // pairing never creates a wishlist bottle; choosing Drink on the pick does
  // (setPairingPickDecision). `gap` stays set after that - it is the
  // snapshot "this was not owned when kept" - so the reachable states are:
  //
  //   gap, no bottleId           not owned (or its wishlist wine was deleted)
  //   gap, bottle on wishlist    linked by Drink: either made by it, or a
  //                              wishlist wine the owner already had
  //   gap, bottle in the cellar  bought since (or already owned when Drink
  //                              was chosen): treated as owned
  //   no gap, bottleId           owned when kept
  //   no gap, no bottleId        owned when kept, deleted since
  //
  // lib/pairings.js pickNotOwned() is the one reader of this table.
  gap       Json?
  // What the owner decided about this wine, once it has been read: "drink"
  // (planned - the tasting is recorded later, from the bottle's page) or
  // "hold" (leave it where it is). NULL is the default and means undecided,
  // deliberately not a third stored word: a suggestion hands over several
  // options and a new pairing has chosen none of them, so no choice is the
  // honest state, and tapping the chosen button again returns to it.
  // Choosing "drink" on a wine that is not owned also puts it on the
  // wishlist (bottleId then points at that wishlist bottle) - see
  // setPairingPickDecision. "drink" is therefore NOT a guarantee that there
  // is a bottle behind it: the wishlist wine can be deleted elsewhere
  // (bottleId goes NULL, the decision stays), and the pairing page offers to
  // add it again. Held to the two words by a CHECK in the migration, which
  // Prisma does not model.
  decision  String?
  // When this wine was actually drunk, from this pairing (a calendar day
  // anchored at noon UTC, like every picked date); NULL = not drunk. `decision`
  // is intent and this is fact, so they are separate: a Drink that was never
  // followed up stays "drink" with no drankAt, and nothing infers one from the
  // other. Old picks stay NULL - not backfilled from tasting notes, which would
  // be a guess. Only a "drink" pick can have one (a CHECK holds that), and
  // Drink cannot be cleared while it is set: undo the tasting first.
  drankAt   DateTime?
  // Whether marking it drunk took a bottle off the wine's count. False when
  // there was nothing to take (the bottle was already History, or is gone, or
  // never was one the owner had): the pick is stamped and the wine left
  // alone. It is what lets Undo put back exactly what was taken, and no more,
  // after a reload - without it, undoing a stamp-only pick would add a bottle
  // that was never removed.
  drankTookBottle Boolean @default(false)

  @@index([pairingId])
  @@index([bottleId])
}

// One row per Claude call: what it cost this Domaine, and why. A ledger of
// individual rows rather than a running counter, so concurrent writers
// (Research's bulk steps run in parallel via after()) never race on one
// number, and so "what did we spend, on what" is answerable afterwards.
// The month's total is a sum over a date range, never a stored value.
//
// Read and written on the plain client, deliberately not through
// lib/scoped-prisma.js: its whole job is to show a signed-in account only
// its own Domaine, and this is the table the app owner reads *across*
// Domaines. It is also written from the Research step route, which has no
// session at all - the job row carries domaineId for exactly that reason.
model UsageEvent {
  id        Int     @id @default(autoincrement())
  domaineId String
  domaine   Domaine @relation(fields: [domaineId], references: [id], onDelete: Cascade)
  // Who pressed the button. Attribution; null once that member is removed,
  // so the Domaine's spending history survives them.
  ownerId   String?
  owner     User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // "scan" | "suggest" | "research" | "estimate-windows" | "photo-details"
  // - the feature names lib/usage.js's callers pass to ai.call(); keep this
  // list and that one in step.
  //
  // Written only by recordUsage in lib/usage.js, and only for a call that
  // succeeded: a failed call costs nothing and leaves no row. A failed
  // write is swallowed (a logged warning, never an error to the user), so
  // the ledger can undercount and the hard stop fails open - by design,
  // since a broken ledger shouldn't take Scan down with it.
  feature String
  // The model the call actually ran on - the lighter one when the Domaine
  // was over its cap, not the one the feature normally uses.
  model   String
  // True when this call ran one tier down because of the cap. False for
  // Scan and the estimators (held at full strength) and for a call that
  // was retried on the normal model after the lighter one refused it.
  lighter Boolean @default(false)

  inputTokens              Int @default(0)
  outputTokens             Int @default(0)
  cacheCreationInputTokens Int @default(0)
  cacheReadInputTokens     Int @default(0)
  webSearches              Int @default(0)
  // Token and search counts are 0 when there were none or the API didn't
  // report them - 0 means "none / not reported", never "unknown".

  // Millionths of a US dollar, computed and stored at write time from the
  // rate table in force that day (lib/usage-pricing.js) - not recomputed
  // later from the tokens, so Anthropic repricing a model can't quietly
  // rewrite last month. Micros rather than cents because most calls cost
  // a fraction of one: a drinking-window estimate is about 0.3 cents, and
  // rounding each row to whole cents would sum to nothing. Clamped at
  // 2,000,000,000 so one runaway row can't overflow the Int column; a model
  // the rate table doesn't recognise is priced as claude-opus-5, so an
  // unknown model overstates spend rather than hiding it.
  costMicros Int

  createdAt DateTime @default(now())

  @@index([domaineId, createdAt])
  @@index([ownerId])
}

// A wine deleted from its own page, kept for 30 days so the delete can be
// undone. NOT a `deletedAt` on Bottle, on purpose: a soft-delete column leaks
// into every plain-client and nested read (a deleted wine would still count,
// list and link) and defeats the cascade / SetNull behaviour pairings and
// flights rely on. Here the Bottle row really is deleted, and everything that
// hung off it is written down first.
//
// `snapshot` is the whole of what restoring needs, as JSON: the bottle's
// columns plus its tasting notes, photos, favorites, flight picks, research
// proposal, and the ids of the pairing picks that pointed at it. Dates are
// ISO strings and are turned back into dates by restoreBottle. `bottleId` is
// the id the wine had, which restore re-uses so every link that survived the
// delete (a pairing pick is only SET NULL, never removed) lines up again; ids
// are never re-issued by the sequence, so it cannot collide.
//
// Written by deleteBottle (the bottle page's delete) and by binAndDelete in
// lib/untouched-bottles.js (Undo import, Undo add-another-purchase), read by
// restoreBottle and the /deleted page, purged lazily when the next delete of
// the SAME Domaine runs - so readers apply the 30-day cutoff themselves. Left out of the
// export: it is a recycle bin, not part of the cellar. Cascades with the
// Domaine.
model BottleTrash {
  id        Int      @id @default(autoincrement())
  domaineId String
  domaine   Domaine  @relation(fields: [domaineId], references: [id], onDelete: Cascade)
  // The id the wine had, re-used by restore. Retention is 30 days but only
  // enforced when the next delete purges, so it is a minimum, not a guarantee
  // of removal; a restore that predates a dropped Bottle column fails with the
  // generic error.
  bottleId  Int
  // The wine's name as it read when deleted ("Rochioli 2018"), for the Undo
  // line and for anything that later lists the bin.
  label     String
  // The list the wine was on when it was deleted ("inventory", "wishlist",
  // "consumed", "flight"), so the Recently deleted page can say where a
  // restore puts it without reading the snapshot. Entries made before this
  // column existed were filled in from their snapshot by a migration, so every
  // entry has one; it stays nullable only because the column was added later.
  listedIn  String?
  snapshot  Json
  deletedAt DateTime @default(now())

  @@index([domaineId, deletedAt])
}

// One CSV import, so "Undo import" works after the page is closed and never
// has to trust ids sent by a browser. `bottleIds` are the wines it created (a
// plain id list, not a relation: undo is "delete those that are still
// untouched", and a wine deleted since simply is not there; a wine restored
// from the bin is removed from its batch by restoreBottle, so Undo import
// cannot delete something the person deliberately brought back). `status` is the
// list they went to ("inventory" or "wishlist"), which undo requires them to
// still be in. Written by commitImport, read by the import page and undoImport,
// purged lazily after 30 days by the next import of the same Domaine (readers
// apply the cutoff too); left out of the export. An Undo that keeps some wines
// still deletes the batch row, so the kept ones cannot be undone later.
model ImportBatch {
  id        Int      @id @default(autoincrement())
  domaineId String
  domaine   Domaine  @relation(fields: [domaineId], references: [id], onDelete: Cascade)
  status    String
  bottleIds Int[]
  createdAt DateTime @default(now())

  @@index([domaineId, createdAt])
}
