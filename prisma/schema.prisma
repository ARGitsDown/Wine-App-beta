// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The person a cellar belongs to.
//
// Phases 0 through 2 of separate cellars per user (FUTURE_CAPABILITIES.md)
// are all done: every bottle, flight and pairing has a real owner,
// lib/scoped-prisma.js filters essentially every read and write by it, and
// an Auth.js session (or, until accounts are configured, the single seeded
// row) decides who that is on each request. This comment described Phase 0
// alone for a while - "ownership exists, but nothing reads it yet" - which
// stopped being true the moment Phase 1 and 2 shipped; a schema comment
// that outlives the state it describes is worse than none; that's what
// this paragraph was caught doing.
//
// Deliberately shaped as Auth.js's `User` from the outset rather than as a
// throwaway `Owner`, because Phase 1 adopts @auth/prisma-adapter and that
// adapter owns this table. Getting the shape right now means Phase 1 adds
// Account/Session/VerificationToken beside it and wires the adapter - it
// never has to move ownership from one table to another on live data, which
// is the one migration in this plan worth being frightened of.
//
// The shape is taken from the adapter's own source, not from memory:
// `createUser` destructures the id away and lets the database generate one
// (`p.user.create` with the rest), so `id` must have a default; and
// `getUserByEmail` looks up `where: { email }`, so email must be unique.
// Nullable because not every provider returns one.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // The three ownership roots. Everything else in this schema inherits its
  // owner through one of these by an existing foreign key - a tasting note
  // belongs to whoever owns its bottle - which is why there are three
  // columns here and not eleven. ResearchJob is a fourth ownerId column,
  // but deliberately not a fourth root: it's a transient job row, not a
  // list of anyone's things.
  bottles      Bottle[]
  flights      TastingFlight[]
  pairings     SavedPairing[]
  researchJobs ResearchJob[]

  // Auth.js's side of this table. Both cascade: deleting a person takes
  // their sign-in records with them.
  accounts Account[]
  sessions Session[]
}

// Auth.js's own three tables, plus the invite list.
//
// Every field name and every unique constraint below is taken from
// @auth/prisma-adapter's source rather than from memory, because the
// adapter queries them by name and a near-miss fails at sign-in rather
// than at build: it looks up `account.findUnique({ where: {
// provider_providerAccountId } })`, `session.findUnique({ where: {
// sessionToken } })` and `verificationToken` by `identifier_token`, so
// those compound keys have to exist with exactly those shapes.
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // snake_case above is not an oversight - those are OAuth's own wire
  // names, and the adapter writes the provider's response through
  // unchanged. Renaming them to match the rest of this schema would mean
  // mapping every one by hand for no gain.
  @@id([provider, providerAccountId])
  @@index([userId])
}

// Database sessions rather than JWTs, which is what an adapter gives you
// by default and the right default here: signing someone out, or removing
// their invite, takes effect on their next request instead of whenever
// their token happens to expire. The cost is a query per request, on an
// indexed unique column, which is nothing next to the page's own reads.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Backs the email/"magic link" sign-in door (lib/auth.js), the second
// route in alongside Google - one row per link sent, deleted the moment
// it is used or once it expires. Created in the original Phase 1
// migration before that second door existed, on the grounds that the
// adapter is a single object that implements every method and one that
// references a missing table fails at the moment someone tries the flow
// rather than at setup; no new migration was needed to put it to use.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Who is allowed in at all. Invite-only was the decision (see
// FUTURE_CAPABILITIES.md): no open registration, no email verification to
// own, and the shared API key stays spent by people who were asked.
//
// A table rather than an environment variable so the list can change
// without a redeploy - which is what makes it worth an admin screen, and
// what makes it scale past the handful an env var comfortably holds.
//
// Email is the join key because it is the only thing known about a person
// before they have ever signed in. Stored lowercased by every writer, so
// the unique constraint means what it looks like it means.
model Invite {
  id    String  @id @default(cuid())
  email String  @unique
  // Whose email this is, in the owner's own words. An invite list of bare
  // addresses becomes unreadable within about four entries.
  note  String?

  createdAt  DateTime  @default(now())
  // Stamped on the invited person's first successful sign-in, so the list
  // shows who has actually turned up rather than only who was asked.
  acceptedAt DateTime?
}

// A single wine, in one of three states:
// - wishlist: something to try or buy, not owned yet
// - inventory: currently owned/in the cellar
// - consumed: already drunk, kept around so its tasting notes stay attached
model Bottle {
  id                   Int       @id @default(autoincrement())
  producer             String
  // The specific bottling, when a producer makes more than one wine from
  // the same grape/vintage - a vineyard designation (e.g. "Rochioli
  // Vineyard") or a proprietary/cuvée name (e.g. "Madeleine", "Insignia").
  // Real labels blur these two concepts constantly (a vineyard-designated
  // wine often carries a proprietary-sounding name too), so this is
  // deliberately one flexible field rather than two, the same reasoning as
  // `region` below.
  bottling             String?
  vintage              Int?
  // Short, header-friendly style label - usually just the grape variety
  // (e.g. "Zinfandel"), but a concise descriptor for blends or wines with
  // no single named variety (e.g. "Red Bordeaux Blend", "Orange Wine").
  // `variety` below can hold a fuller, more detailed description.
  type                 String?
  variety              String?
  // A grape name from lib/varietals.js's canonical list, auto-matched from
  // `type`/`variety` on save (see lib/varietal-match.js) whenever they
  // name exactly one recognized grape - null for a blend or an
  // unrecognized/obscure variety, rather than guess. Lets filtering match
  // synonyms (e.g. "Grenache" also finds a bottle logged as "Garnacha")
  // without changing what's actually printed on the label in `variety`.
  canonicalVariety     String?
  // The primary sub-country identifier - a US state for domestic wines
  // (e.g. "California"), or a named wine region/appellation for everything
  // else (e.g. "Bordeaux", "Burgundy", "Central Otago"). Deliberately just
  // one flexible field rather than a rigid state/region/subregion
  // hierarchy, since that hierarchy genuinely differs by country and even
  // by wine - a fuller drill-down (like Bordeaux -> Medoc -> ...) can be
  // layered on top of this later without a schema rework.
  region               String?
  // An optional finer-grained locator within `region` (e.g. "Margaux"
  // within region "Bordeaux", or "Gevrey-Chambertin" within "Burgundy") -
  // BACKLOG.md #2's lightweight step: one more flat, optional field rather
  // than a rigid multi-level hierarchy tree, so a country/region/
  // sub-region/appellation drill-down can still be layered on properly
  // later without this being in the way.
  subRegion            String?
  country              String?
  quantity             Int       @default(1)
  status               String    @default("wishlist")
  // The owner's own words about the bottle, as opposed to criticNotes
  // (someone else's words, written by Research) or a TastingNote (about one
  // evening). Where the bottle came from lives here - a shop, the winery, a
  // gift - which is the only fact about a bottle with no field of its own.
  // Deliberately free text rather than an acquisitionSource column: the
  // answers are long-tailed and never filtered on.
  notes                String?
  // Alcohol by volume, as printed on the label (e.g. 14.5 for "14.5%").
  // Legally required on nearly every label, so easy to capture during
  // scanning, and useful for style/pairing reasoning (a 15.5% Zinfandel
  // behaves very differently at the table than a 12.5% Riesling).
  abv                  Float?
  // A small fixed vocabulary (Red/White/Rosé/Orange/Sparkling/Dessert/
  // Fortified - see WINE_COLORS in lib/wine-colors.js), distinct from `type`
  // (which names the grape/style, not the color) so "show me all my
  // whites" works regardless of how `type` happens to be worded. A plain
  // String rather than a Prisma enum, same reasoning as `status` below -
  // easier to extend the vocabulary later without a migration. Not
  // auto-guessed from type/variety on manual entry (the same grape can
  // make wines of different colors - a Pinot Noir rosé, for instance - so
  // a text-based guess could confidently mislabel one); the scan feature
  // does infer it, since it can actually see the label/context.
  wineColor            String?
  // The drinking window: the year range this wine is expected to be at its
  // best (e.g. drinkFrom 2026, drinkTo 2034). Both nullable and independent
  // - a wine can have a known start with no known end, or vice versa. Feeds
  // the Suggest feature's reasoning (don't recommend something not ready
  // yet, or already past peak) - see BACKLOG.md #4.
  drinkFrom            Int?
  drinkTo              Int?
  // True when drinkFrom/drinkTo came from an AI guess (scan, Research's
  // fallback, a bulk backfill, or a dedicated estimate action - see
  // BACKLOG.md #7) rather than something stated on the label, found via a
  // real Research citation, or typed by hand. Shown as a distinct badge so
  // it's clear which windows are worth double-checking. Only ever set by
  // those estimate-producing actions; a plain edit through updateBottle
  // clears it back to false when the years actually change (the human has
  // now made the call), and leaves it alone otherwise.
  drinkWindowEstimated Boolean   @default(false)
  // Set when the scan feature wasn't confident about every field it filled
  // in (see `confident` on the scan tool). Surfaces the bottle in the
  // "Needs research" queue until someone runs (or dismisses) the "Research
  // further" action on its page - never cleared automatically otherwise.
  needsResearch        Boolean   @default(false)
  // The scanned label photo, uploaded to Vercel Blob storage (see
  // lib/blob.js) at scan time - null for a manually-added bottle, or when
  // blob storage isn't configured (the scan feature still works without
  // it, same graceful-degradation spirit as ANTHROPIC_API_KEY being
  // optional). One photo can hold several wines (a shop's tasting sheet),
  // in which case each of those bottles shares the same photoUrl.
  photoUrl             String?
  // When the last bottle of this wine actually left the cellar. Nullable
  // and only meaningful for a `consumed` row: set on whichever action moved
  // it there, cleared if it ever moves back out, so a bottle returned to
  // Inventory doesn't keep claiming a date it was emptied on. Rows that
  // reached History before this column existed have null, which reads as
  // "emptied, date unknown" rather than as a wrong date - see BACKLOG.md
  // #10. Stored like TastingNote.tastedAt, anchored at noon UTC: see
  // lib/tasting-date.js for why a date-only value needs that.
  emptiedAt            DateTime?
  // When this wine entered the cellar, as opposed to createdAt's "when the
  // row was typed in" - the two are only the same for a bottle you log the
  // day you buy it. Nullable, and deliberately left null rather than
  // guessed: a wishlist bottle isn't owned yet, and a wine logged straight
  // to tasting notes never sat in the cellar at all, so neither has an
  // acquisition date to record. Derived from status changes the way
  // emptiedAt is (see acquiredAtForStatus in lib/bottle-dates.js) - stamped when
  // a row arrives in the cellar, cleared if it goes back to the wishlist,
  // and carried through to consumed, where "bought 2019, drunk 2026" is
  // exactly the fact worth keeping. Rows that predate this column have
  // null, which reads as "date unknown" rather than as a wrong date - see
  // BACKLOG.md #10. Anchored at noon UTC like every other date-only value:
  // see lib/tasting-date.js.
  acquiredAt           DateTime?
  // Existing winemaking/tasting notes found *about* this wine by the
  // Research feature - the winery's own description, critic write-ups
  // (Wine Advocate, Wine Spectator, Halliday, Jancis Robinson, etc.), or
  // other published reviews - as opposed to `notes` (this cellar owner's
  // own free-form notes) and `TastingNote` (their own dated tasting
  // entries). Only ever populated by applying a research result; never set
  // by scanning or by a plain manual edit, though it's an ordinary
  // editable field once research has filled it in.
  criticNotes          String?

  // Who this bottle belongs to. See the User model above: one owner today,
  // seeded by the migration, with nothing yet reading this column.
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tastingNotes     TastingNote[]
  favorites        Favorite[]
  flightPicks      FlightPick[]
  pairingPicks     PairingPick[]
  photos           BottlePhoto[]
  researchProposal ResearchProposal?

  // Every list page filters on `status`, and the nav badge counts
  // `needsResearch`, on every request. A few hundred rows sequential-scan
  // fine, so this isn't fixing a problem you can feel today - it's just
  // cheap to have in place before the cellar is big enough to notice.
  @@index([status])
  @@index([needsResearch])
  // Postgres does not index a foreign key automatically, and once Phase 2
  // scopes queries this is the column every single one of them filters on.
  @@index([ownerId])
}

// One additional photo attached to an already-saved bottle - `photoUrl`
// above is the single label photo captured at scan time; this is for
// anything worth documenting afterward (a back label, a cork, a case),
// added via "Add a photo" on the bottle's detail page - akin to how the
// Research feature adds detail after the fact rather than only at save
// time. Not read by any AI feature, just stored and shown back.
model BottlePhoto {
  id        Int      @id @default(autoincrement())
  bottleId  Int
  bottle    Bottle   @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())

  // Postgres does not index a foreign key automatically, and this column is
  // what every lookup and cascade delete goes through. Same below.
  @@index([bottleId])
}

model TastingNote {
  id       Int      @id @default(autoincrement())
  bottleId Int
  bottle   Bottle   @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  note     String
  // Nullable: a note can be logged without a personal score - e.g. a shop's
  // own tasting-sheet write-up brought in via the scan feature, before (or
  // instead of) rating it yourself.
  rating   Int?
  tastedAt DateTime @default(now())

  @@index([bottleId])
}

// A friend/family member browsing the cellar at /guest to shortlist bottles
// for their next visit - not a real account (no password), just a name
// remembered via a cookie so favoriting works across visits from the same
// browser. Looked up case-insensitively on entry so the same person typing
// their name again reuses their existing guest record instead of forking
// it. This is deliberately lightweight; real multi-user accounts (separate
// cellars per person) are a much bigger, separate future capability - see
// FUTURE_CAPABILITIES.md.
model Guest {
  id        Int        @id @default(autoincrement())
  name      String
  createdAt DateTime   @default(now())
  favorites Favorite[]
}

// One guest's shortlist pick from the (inventory-only) cellar they browsed
// at /guest - surfaced back to the owner so they know what to pull before
// that guest's next visit.
model Favorite {
  id        Int      @id @default(autoincrement())
  guestId   Int
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  bottleId  Int
  bottle    Bottle   @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // The unique already indexes guestId as its leading column, so only the
  // other direction (which guests favorited this bottle) needs one.
  @@unique([guestId, bottleId])
  @@index([bottleId])
}

// A saved Suggest tasting-flight result (mode: "tasting") - unlike a
// pairing recommendation, which is ephemeral and logs straight into a
// tasting note, a themed flight is worth keeping around as a queue to pull
// bottles from over time. Only real owned-bottle picks are saved; a gap
// suggestion mixed into the same result isn't part of "what to pull from
// the cellar" and can already be added to the wishlist independently.
model TastingFlight {
  id      Int     @id @default(autoincrement())
  // A short evocative name for the flight ("The Many Faces of Pinot") -
  // the heading, and what the flights list links on. Nullable because
  // flights saved before this existed have only a summary, which they
  // keep showing as their heading rather than getting a guessed title.
  title   String?
  // The fuller explanation of the theme and its ordering. Before `title`
  // it was doing both jobs, which made for a three-sentence link.
  // Nullable since flights can be built by hand: a flight you assembled
  // yourself has a theme name and often nothing else to say. At least one
  // of title/summary is always set - guaranteed where flights are written,
  // not by the columns, since neither can be NOT NULL on its own.
  summary String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime     @default(now())
  picks     FlightPick[]

  @@index([ownerId])
}

// One bottle's place in a saved flight, in tasting order.
model FlightPick {
  id       Int           @id @default(autoincrement())
  flightId Int
  flight   TastingFlight @relation(fields: [flightId], references: [id], onDelete: Cascade)
  bottleId Int
  bottle   Bottle        @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  order    Int
  // Why this bottle is in this flight, in the model's words. Null for a
  // pick added by hand, which has a position in the running order but no
  // argument attached to it.
  reason   String?
  consumed Boolean       @default(false)

  @@index([flightId])
  @@index([bottleId])
}

// A drinking-window estimate Claude has already produced for a given wine,
// keyed on what actually determines the answer (producer, bottling, grape,
// region, vintage - see drinkWindowCacheKey in lib/drink-window-cache.js)
// rather than on a bottle id. Two rows for the same wine, or the same wine
// re-added months later, then reuse the earlier answer instead of paying
// for an identical question - see BACKLOG.md #7.
//
// Deliberately not a hand-curated reference table: that would need the same
// domain judgment we're already asking the model for, just harder to keep
// current. This only avoids asking twice.
model DrinkWindowEstimate {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  drinkFrom Int?
  drinkTo   Int?
  createdAt DateTime @default(now())
}

// A research pass waiting to be reviewed.
//
// Research used to live in React state on the bottle page and die the
// moment you navigated away, which left "researched but not yet approved"
// with nowhere to exist - so the queue needed somewhere to put it.
//
// One row per bottle: researching a second time replaces the pending
// answer rather than stacking up proposals nobody asked for.
model ResearchProposal {
  id       Int    @id @default(autoincrement())
  bottleId Int    @unique
  bottle   Bottle @relation(fields: [bottleId], references: [id], onDelete: Cascade)

  // The model's answer, shaped exactly like RESEARCH_TOOL's input schema -
  // see the comment beside it in app/actions.js. Json rather than a dozen
  // mirrored Bottle columns: the proposal is only ever read back whole and
  // rendered, and this way the research schema can change without a
  // migration. lib/research-fields.js is what reads it.
  proposed Json

  // What the model says it found, and where. Kept beside the proposal
  // because both are part of judging it, not part of the bottle.
  summary String
  sources String[]

  // Compared against the bottle's updatedAt to spot a proposal computed
  // from values that have since changed. Flagged in the review rather than
  // discarded - see isProposalStale().
  createdAt DateTime @default(now())
}

// One run of "Research all", as a row rather than as a closure.
//
// The bulk pass has been rewritten twice for the same reason, and this
// table is the third and last version of the answer. Originally the
// chunking lived in the browser, so navigating away stopped the run dead.
// Moving the chunking server-side and chaining with `after()` fixed that
// but bounded the whole queue to one invocation's timeout, which is a
// ceiling the browser loop never had - a long enough queue just stopped
// partway, looking exactly like the bug it replaced.
//
// Both versions had the same root flaw: the queue only existed in memory,
// so its life was tied to something that dies. Here it is a row. Each step
// reads what is left, does what it can afford inside its own timeout,
// writes back, and asks for a fresh invocation to continue - so the total
// run has no ceiling, and the progress the page shows is the real server
// state rather than a counter in a tab that may not be open.
model ResearchJob {
  id    Int    @id @default(autoincrement())
  // What each step has to present to be allowed to run, since the step
  // endpoint is a plain HTTP route rather than a signed-in page - see
  // ownerId below for why that matters here specifically. A per-job random
  // value rather than a shared deployment secret: it needs no configuration
  // to be correct, it is useless once its own job is finished, and it never
  // reaches the browser - only the server ever reads or sends it.
  token String @unique

  // Who asked. Every other owner-scoped model (Bottle, TastingFlight,
  // SavedPairing) gets its owner enforced by the Prisma Client Extension in
  // lib/scoped-prisma.js, which reads the signed-in session - but a bulk
  // research step runs from app/api/research/step/route.js, a plain HTTP
  // route hit by a server-to-server fetch with no cookies attached (see the
  // route's own comment). There is no session to read there, so ownership
  // has to be recorded as data at job creation time instead, and the step
  // that fetches bottles to research filters on this column explicitly
  // rather than going through the session-based extension. Without it, a
  // job's bottleIds would be trusted at face value with nothing checking
  // they belong to whoever started the run.
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // The queue as it was requested: the denominator of the progress bar,
  // and the record of what this run was asked to do.
  bottleIds  Int[]
  // What is still owed. Rewritten after each step rather than advanced by
  // an index, because a step finishes whole *questions* (duplicate wines
  // are researched once and the answer shared), which do not line up with
  // contiguous slices of the list.
  pendingIds Int[]

  researched Int @default(0)
  failed     Int @default(0)

  // "running" until pendingIds empties, then "done". No "failed" state: a
  // bottle whose research fails is counted in `failed` and the run carries
  // on, which is the behaviour the queue has always had.
  status String @default("running")

  createdAt DateTime @default(now())
  // Touched by every step, which is what lets a reader tell a run that is
  // working from one whose chain broke mid-flight (a deploy, a crash)
  // without a heartbeat column of its own.
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerId])
}

// A pairing worth keeping. Its own table rather than a row in
// TastingFlight, for three reasons that all point the same way.
//
// Origin: a flight has two - Suggest and NewFlightForm - and FlightPick's
// `reason` is nullable for the hand-added ones. A pairing only ever comes
// from Suggest. Lifecycle: isOpenFlight() says a flight is a queue while
// any pick is undrunk and "a record now, not a queue" once they are all
// done; a pairing has no such state, it is a decision you wrote down.
// Owned vs not: FlightPick.bottleId is correctly NOT NULL because you
// cannot open a wine you do not have, and "buy this for that dish" is the
// entire point of Suggest's include-outside toggle.
//
// Sharing one table would leave `order` and `consumed` meaningless for
// half the rows, which is "null means not applicable" living in the same
// column as "null means unknown" - the distinction the rest of this
// schema works to keep.
model SavedPairing {
  id             Int     @id @default(autoincrement())
  // The model's own title, which the owner can rename. NOT NULL unlike
  // TastingFlight.title: every pairing is born from a Suggest result,
  // where the title is a required tool field, so there is no such thing
  // as a pairing without one and no reader that has to cope with the
  // absence.
  title          String
  // What was asked for, word for word, plus the three settings that were
  // in force. These are what make refining cheap - reload the form from a
  // saved pairing, change one control, run it again - and without them
  // iterating would be a feature rather than four columns.
  request        String
  character      String
  // Which model answered: "standard" (Sonnet) or "sommelier" (Opus). Was
  // `effort` and held a thinking-budget level, back when Suggest always
  // ran on Opus and the dial only changed how long it thought. Renamed
  // rather than reused because the column records what was in force, and
  // what is in force is now a different fact about the request - leaving
  // the old name would have meant a column called effort holding a model.
  // See lib/suggest-depth.js for what the two levels cost and buy.
  depth          String
  includeOutside Boolean
  // The model's "why these". Nullable because it is the argument, not the
  // identity: a pairing with its picks and their reasons is still whole
  // without it.
  summary        String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime      @default(now())
  picks     PairingPick[]

  @@index([ownerId])
}

model PairingPick {
  id        Int          @id @default(autoincrement())
  pairingId Int
  pairing   SavedPairing @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  // The order the wines were suggested in. Not a tasting order the way
  // FlightPick.order is - a menu's courses have a sequence, a single dish
  // with one wine does not - but the order is still what was said, and
  // re-sorting it on read would be inventing something.
  order     Int
  // Which dish or course this wine is for. Null when the request named one
  // dish, or none: a pairing can be a dish with one wine or a menu with
  // several, and this column is what tells them apart.
  dish      String?
  reason    String

  // The wine, if it is one the owner has. SetNull rather than Cascade -
  // the opposite of FlightPick - because the two rows mean different
  // things. A bottle you no longer have cannot be in a queue of bottles to
  // open, but it can certainly be in the record of what you drank with the
  // lamb in June, and losing that record to an October tidy-up would be
  // the wrong answer.
  bottleId  Int?
  bottle    Bottle? @relation(fields: [bottleId], references: [id], onDelete: SetNull)
  // How the wine read at the moment it was saved. The reason the row
  // above can go null without the pairing becoming unreadable, and the
  // reason a bottle renamed since still shows the name it was chosen
  // under.
  wineLabel String
  // The producer alone - the same snapshot as wineLabel, trimmed to what a
  // list summary can afford to show beside two or three dish names without
  // crowding them out. Stored rather than parsed back out of wineLabel at
  // read time, for the same reason wineLabel itself is a stored snapshot
  // rather than a live read off the bottle: re-deriving "just the
  // producer" from a formatted string (which quoted bottling name, which
  // 4-digit number is a vintage and not part of the name) is exactly the
  // fragile parsing this schema avoids elsewhere.
  wineName  String
  // A wine that was not owned, as {producer, type, region, country}. Json
  // for the same reason ResearchProposal.proposed is: it is only ever
  // rendered as a unit, never queried into. It also means keeping a
  // pairing never quietly creates a wishlist bottle nobody asked for.
  gap       Json?

  @@index([pairingId])
  @@index([bottleId])
}
