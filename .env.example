# Copy this file to .env and fill in a real value. .env itself is never
# committed (see .gitignore) since it holds a real credential.

# The same hosted Postgres database is used everywhere (there's no separate
# local database) — get this connection string from your database provider,
# e.g. the Storage tab in Vercel after adding a Postgres integration.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Powers the "Scan a label" feature (reading a wine label photo). Get a key
# at https://console.anthropic.com/ - Account Settings -> API Keys.
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: lets the scan feature keep the label photo itself, not just the
# data read from it. Add the Vercel Blob integration to your project
# (Storage tab) and it sets this automatically. Without it, scanning still
# works exactly the same - bottles just save without a photo.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
