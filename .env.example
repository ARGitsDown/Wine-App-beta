# Everything this app can be told, and what happens when it is not told it.
# Nothing here is required to run the cellar: every variable below is a
# capability that switches on when set and degrades honestly when absent.

# The database. The only genuinely required one.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Claude, for Scan, Suggest and Research. Without it those three features
# report that they are unavailable (lib/ai-errors.js) and the rest of the
# cellar works normally.
ANTHROPIC_API_KEY=""

# Photo storage, for scanned labels. Without it scanning still works and
# simply keeps no picture.
BLOB_READ_WRITE_TOKEN=""

# --- Accounts (Phase 1 of separate cellars per user) ---------------------
#
# All three must be set together. Until they are, the app runs exactly as
# it always has: one owner, no sign-in, every page open. That is a
# deliberate state - it means this can be deployed and watched before it
# changes anything, and a half-configured deploy cannot lock the owner out
# of their own cellar.
#
# AUTH_SECRET signs the session cookie. Generate one with:
#   npx auth secret
AUTH_SECRET=""

# From Google Cloud Console -> APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> Web application.
#
# Authorised redirect URIs must include, exactly:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-DOMAIN/api/auth/callback/google
#
# Google will also ask you to configure the OAuth consent screen first.
# "External" with the app left in Testing is the right choice for an
# invite-only app used by a handful of people; add each person's Google
# address as a Test user there as well as inviting them in the app.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Only needed when NOT deploying to Vercel. Auth.js trusts the request host
# automatically when it sees Vercel's own environment (or when running in
# development); anywhere else in production it refuses with UntrustedHost
# and every auth endpoint returns 500. Set this to "true", or set AUTH_URL
# to the app's public origin.
AUTH_TRUST_HOST=""

# Optional, and worth setting for exactly one deploy. The cellar that
# already exists is unclaimed until somebody signs in, and the first
# allowed sign-in adopts it. Setting this to your own Google address means
# only you can be that person, which turns "whoever gets there first
# inherits every bottle" into "only I do". It does nothing once claimed.
OWNER_EMAIL=""
